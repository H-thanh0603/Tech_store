# =============================================================================
# TechStore env template
# Local: copy to .env.local after `supabase start`
# Production (Vercel): set the same keys in Project → Settings → Environment
# Variables. Never commit real secrets. Never put service_role in NEXT_PUBLIC_*.
# Deploy guide: docs/ops/DEPLOY.md
# =============================================================================

# --- Supabase (local Docker or cloud project) ---
# Local: http://127.0.0.1:54321 + keys from `supabase status`
# Cloud: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only (admin catalog CRUD + privileged RPCs). Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Public site origin for sitemap / Open Graph / JSON-LD
# Local: http://localhost:3000
# Production: https://your-app.vercel.app (set after first deploy, then redeploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VietQR demo (COD/transfer UI). Optional for pure catalog demos.
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=TECHSTORE

# VNPay online payment. Optional: without both keys the checkout hides VNPay.
# Sandbox credentials: https://sandbox.vnpayment.vn/apis/docs/trial/#nghi-thuc-demo
VNPAY_TMN_CODE=
VNPAY_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# VNPay auto-refund. Optional: without VNPAY_SECRET_REFUND the returns flow
# stays manual (dashboard merchant.vnpayment.vn) and refunds are recorded
# as mock receipts in payment_refunds.
# VNPAY_SECRET_REFUND=
# VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Carrier integration (GHN / GHTK). Optional: without keys the checkout
# keeps the internal rate table; lib/shipping returns mock quotes/tracking
# flagged isMock for UI testing.
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_API_BASE=https://online-gateway.ghn.vn/shiip/public-api
# GHTK_TOKEN=
# GHTK_API_BASE=https://services.giaohangtietkiem.vn/services/shipment

# Resend transactional email. Optional: without a key notifications stay
# pending in notification_outbox and are never sent.
RESEND_API_KEY=
EMAIL_FROM=TechStore <onboarding@resend.dev>

# Shared secret guarding /api/cron/* routes (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=change-me-to-a-long-cron-secret

# Sentry error monitoring. Optional: without a key Sentry is disabled.
# Create project at https://sentry.io → Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=


# Shopping assistant (pilot, TypeScript port of anthropics/commerce-agents).
# Server-only: without the selected provider's key the widget replies that
# AI is unconfigured.
# Provider: anthropic (default) or deepseek.
# ASSISTANT_PROVIDER=anthropic
# Anthropic key: https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# DeepSeek key: https://platform.deepseek.com → API Keys.
# DEEPSEEK_API_KEY=
# Optional model override (defaults: claude-haiku-4-5 / deepseek-chat).
# ASSISTANT_MODEL=
# HMAC secret signing merchant staged-change envelopes (required in production).
# ASSISTANT_STAGING_SECRET=change-me-to-a-long-staging-secret

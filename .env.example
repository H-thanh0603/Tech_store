# Local Supabase (from `supabase start` output). Local dev defaults only -
# never commit real project keys. The anon key is safe for the browser because
# RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only admin (never NEXT_PUBLIC_*). From `supabase status` / `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
ADMIN_SECRET=change-me-to-a-long-local-admin-secret

# Local VietQR demo (not production)
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=TECHSTORE

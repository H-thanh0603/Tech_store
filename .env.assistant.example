# =============================================================================
# TechStore — Assistant credentials (LLM chat + Jev decision layer)
#
# Đây là file RIÊNG cho key/model của trợ lý AI, tách khỏi `.env.local`
# (Supabase, VNPay, Resend…). Copy sang `.env.assistant` rồi điền:
#
#     cp .env.assistant.example .env.assistant
#
# `.env.assistant` đã nằm trong .gitignore — KHÔNG commit key thật.
#
# Ai đọc file này: `lib/env/assistant-env.ts`, gọi từ `next.config.ts`
# (dev/build/start), `tests/setup.ts` (vitest) và `lib/assistant/config.ts`.
#
# Thứ tự ưu tiên (mặc định): key trong file này THẮNG `.env` / `.env.local`
# và cả biến môi trường có sẵn của shell — sửa 1 file là đủ.
# Trên CI / Vercel thì đặt `ASSISTANT_ENV_PRECEDENCE=process` để biến môi
# trường thật luôn thắng file (file này thường không tồn tại ở đó).
#
# Đổi đường dẫn file bằng `ASSISTANT_ENV_FILE=/path/to/file`.
#
# Gateway OpenAI-compatible nào cũng dùng được: model chỉ cần gọi được
# `/chat/completions`. Gateway local (vLLM, LiteLLM, 9router…) trỏ
# base URL về `http://localhost:PORT/v1`.
# =============================================================================


# =============================================================================
# 1. LLM của phần chat  (bắt buộc — không có thì widget báo "chưa được cấu hình")
# =============================================================================
# Chọn đúng 1 provider: anthropic | deepseek | openrouter | tokenrouter
#   anthropic   → ANTHROPIC_API_KEY
#   deepseek    → DEEPSEEK_API_KEY
#   openrouter  → OPENROUTER_API_KEY
#   tokenrouter → TOKENROUTER_API_KEY + TOKENROUTER_BASE_URL (gateway bất kỳ)
# Bỏ trống ASSISTANT_PROVIDER = mặc định `anthropic`.
ASSISTANT_PROVIDER=

# --- Chỉ điền key của provider bạn chọn (các dòng khác để trống) -------------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=
# Gateway OpenAI-compatible bất kỳ. Ví dụ gateway local:
#   http://localhost:20128/v1     (9router — provider `tokenrouter` là slot
#                                  chung, trỏ base URL về là xong)
#   http://localhost:4000/v1      (LiteLLM)
#   http://localhost:11434/v1     (Ollama)
TOKENROUTER_BASE_URL=
TOKENROUTER_API_KEY=

# --- Model + ngân sách trả lời (tùy chọn) -----------------------------------
# Mặc định theo provider: claude-haiku-4-5 | deepseek-chat |
# anthropic/claude-haiku-4-5 | z-ai/glm-5.3-free (tokenrouter).
# Model PHẢI hỗ trợ tool-calling: agent cần gọi search_products, add_to_cart…
# Model reasoning thuần (R1, deepseek-reasoner…) bị chặn vì tool-call không ổn định.
ASSISTANT_MODEL=
# Trần token mỗi lượt trả lời, 256–32000, mặc định 1024.
# Model reasoning cần trần cao hơn (đốt token vào reasoning_content trước
# khi trả content) — nhưng reasoning cũng làm chậm first-chunk gấp 10-20x,
# nên tắt reasoning (ASSISTANT_REASONING=0) thay vì tăng trần.
ASSISTANT_MAX_TOKENS=

# Tắt chain-of-thought ẩn của model reasoning trên gateway free
# (đo thật: nex-n2.5-pro first-chunk 30s → 1.6s, tool-call giữ nguyên).
# `0` = tắt (khuyên dùng cho chat tool-calling). Trống = để model tự quyết.
ASSISTANT_REASONING=

# --- Nguồn gốc gửi cho gateway (tùy chọn) -----------------------------------
# HTTP-Referer khi gọi OpenRouter/TokenRouter; mặc định lấy NEXT_PUBLIC_SITE_URL.
SITE_URL=



# =============================================================================
# 2. Jev AI — lớp quyết định ngữ nghĩa  (tùy chọn, FAIL-OPEN)
# =============================================================================
# Jev chấm scope câu hỏi (in-scope / gray / off-topic) và xếp hạng lại sản phẩm
# theo độ liên quan. Jev KHÔNG phải LLM sinh text nên không thay phần chat;
# nó là lớp quyết định chạy TRƯỚC / BÊN CẠNH LLM (lib/assistant/jev.ts).
#
# Không có key / gateway chết / JSON hỏng → tự rớt về scope keyword + thứ tự
# DB, chat không bao giờ gãy. Muốn tắt hẳn: JEV_ENABLED=0.

# Bật/tắt. Mặc định bật khi có key. `0` = tắt hẳn (không gọi mạng).
JEV_ENABLED=

# Ép transport: `chat` (OpenAI-compatible) hoặc `evaluate` (Vercel AI Gateway).
# Trống = tự chọn theo JEV_MODEL (typesafe-ai/*) và JEV_BASE_URL.
JEV_API=

# Key riêng cho Jev. Bỏ trống → tái dùng OPENROUTER_API_KEY rồi TOKENROUTER_API_KEY.
# Key Vercel AI Gateway: Vercel → AI Gateway → API Keys.
JEV_API_KEY=

# Gateway OpenAI-compatible. 2 lựa chọn:
#   Vercel AI Gateway (Jev thật): https://ai-gateway.vercel.sh/v1
#     + JEV_MODEL=typesafe-ai/jev   (TypeSafe System One — khuyên dùng)
#   Gateway local (9router…): base URL local, + model tool-capable bất kỳ —
#     prompt ép JSON-only {choice, confidence, order} nên contract vẫn typed.
# Suffix `/chat/completions` tự động thêm — điền base URL là đủ.
JEV_BASE_URL=

# Model trả typed decision.
#   Vercel AI Gateway : typesafe-ai/jev   (model Jev thật)
#   OpenRouter cloud  : typesafe/jev-latest
#   Gateway local     : model tool-capable bất kỳ (ví dụ openrouter/nex-agi/nex-n2.5-pro:free)
JEV_MODEL=

# Ngưỡng tự tin tối thiểu để tin Jev hơn kết quả keyword, 0–1, mặc định 0.7.
# Jev trả confidence thấp hơn → giữ nguyên verdict của keyword.
JEV_THRESHOLD=

# Timeout mỗi lần gọi, 500–15000 ms, mặc định 3500.
JEV_TIMEOUT_MS=

# Trần token mỗi decision, 64–4096, mặc định 512.
# Model có reasoning đốt token vào phần suy nghĩ trước khi in JSON; để 128
# sẽ bị `content: null` (đã gặp thật với Ling/GLM trên gateway local).
JEV_MAX_TOKENS=

# Tắt re-rank sản phẩm sau search (tiết kiệm 1 call JEV ~5s qua Vercel).
# `0` = giữ thứ tự DB. Trống = bật re-rank.
JEV_RERANK=

# Lọc tool theo bucket trước mỗi turn (shopping: catalog/cart/order/policy/
# fulfillment; merchant: metrics/inventory/listing/campaign).
# Keyword rõ → subset cứng, follow-up gray → kế thừa bucket turn trước,
# còn lại Jev chọn bucket, thiếu tự tin → full toolset.
# Mỗi TurnResult có `toolFilter` (source/buckets/sent/full), route trả về
# field `tool_filter`. Rollback khẩn: JEV_TOOL_FILTER=0.
JEV_TOOL_FILTER=


# =============================================================================
# 3. Hành vi trợ lý  (tùy chọn)
# =============================================================================
# Trích xuất sở thích khách bằng model sau mỗi lượt (+1 call/lượt).
# Mặc định `rule` (rule-based, không tốn thêm call). `model` = bật.
ASSISTANT_MEMORY=rule

# Tra lịch sử đơn theo SĐT (mặc định bật). `1` = tắt.
ASSISTANT_NO_ORDER_HISTORY=

# Cho phép gửi ảnh vào chat. Mặc định tắt (text-only, báo đúng khả năng).
ASSISTANT_IMAGE_INPUT=

# HMAC ký envelope staged-change của merchant agent. BẮT BUỘC ở production,
# random >= 32 ký tự (openssl rand -base64 48).
ASSISTANT_STAGING_SECRET=

# Chỉ dùng cho dev/test khi chưa có secret thật: cho phép fallback dev
# đã biết trước. KHÔNG bao giờ bật khi có dữ liệu thật.
ALLOW_DEV_STAGING=


# =============================================================================
# 4. Cách tự kiểm tra sau khi điền
# =============================================================================
#   npx tsc --noEmit && npx vitest run tests/assistant        # unit + parse env
#   npm run dev                                               # khởi động, xem dòng
#                                                             # "- Assistant env: .env.assistant (N keys)"
#   npm run agent:smoke                                       # chat thật 3 câu
#   JEV_LIVE_PROBE=1 npx vitest run tests/assistant/jev-live.test.ts   # Jev thật
